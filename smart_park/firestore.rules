rules_version = '2';

// Who may do what:
// - Drivers read establishments and their own tickets, and may change a
//   ticket's plate. Tickets, payments, payment splits and stats are
//   otherwise written only by Cloud Functions (Admin SDK, which bypasses
//   these rules), so no client can mark anything paid.
// - Parking owners manage their own establishment and staff, and read their
//   own establishment's tickets, splits and gate logs.
// - Staff (staff_accounts/{uid}) work one facility's gate.
// - Admins (users/{uid}.role == 'admin') review establishments and read
//   everything. adminLevel 'super' may also give and take admin access,
//   through Cloud Functions only (src/admin_roles.js).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Staff sign in with a synthetic-domain email (see
    // staff_credentials.dart) and can never complete Firebase's email
    // verification flow. Anyone could register such an email, so this only
    // grants general read access; staff powers come from isStaffOf().
    function isVerifiedOrStaff() {
      return signedIn() &&
        (request.auth.token.email_verified == true ||
         request.auth.token.email.matches('.*@staff[.]smartpark[.]internal$'));
    }

    function userPath(id) {
      return /databases/$(database)/documents/users/$(id);
    }

    // The app reads the role from any of these keys (role_based_home_page).
    function roleOf(data) {
      return data.get('role', data.get('Role', data.get('userRole', '')));
    }

    function myRole() {
      return exists(userPath(uid())) ? roleOf(get(userPath(uid())).data) : '';
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    // Admins made before access levels existed have no adminLevel.
    function isSuperAdmin() {
      return isAdmin() && get(userPath(uid())).data.get('adminLevel', 'admin') == 'super';
    }

    // No admin decides a case about their own account.
    function notAboutMe(data) {
      return data.get('driverId', '') != uid() && data.get('ownerId', '') != uid();
    }

    function isParkingOwner() {
      return isVerifiedOrStaff() && myRole() == 'Parking Owner';
    }

    function staffPath(id) {
      return /databases/$(database)/documents/staff_accounts/$(id);
    }

    // Owners deactivate staff (active: false) instead of deleting the
    // record, so past scans keep a name. Records without the field are active.
    function isStaffOf(establishmentId) {
      return signedIn() &&
        exists(staffPath(uid())) &&
        get(staffPath(uid())).data.facilityId == establishmentId &&
        get(staffPath(uid())).data.get('active', true) != false;
    }

    // A supervisor is a staff record with role 'supervisor': they run the
    // facility day to day (docs/supervisor-role.md). Prices, documents,
    // earnings, refunds and hiring stay with the owner.
    function isSupervisorOf(establishmentId) {
      return isStaffOf(establishmentId) &&
        get(staffPath(uid())).data.get('role', 'staff') == 'supervisor';
    }

    // Operations the owner or the facility's supervisor may do.
    function canOperate(establishmentId) {
      return isOwnerOf(establishmentId) || isSupervisorOf(establishmentId);
    }

    function establishmentPath(id) {
      return /databases/$(database)/documents/establishments/$(id);
    }

    function isOwnerOf(establishmentId) {
      return signedIn() &&
        exists(establishmentPath(establishmentId)) &&
        get(establishmentPath(establishmentId)).data.ownerId == uid();
    }

    // Same as isOwnerOf, but sees an establishment created in this batch.
    function willOwn(establishmentId) {
      return signedIn() &&
        existsAfter(establishmentPath(establishmentId)) &&
        getAfter(establishmentPath(establishmentId)).data.ownerId == uid();
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------- users ----------

    // Roles a user may give themselves. 'staff' only with a staff record
    // made by their owner; 'admin' never.
    function selfAssignableRole(role) {
      return role in ['Driver', 'Parking Owner'] ||
        (role == 'staff' && exists(staffPath(uid())) &&
          get(staffPath(uid())).data.get('role', 'staff') == 'staff') ||
        (role == 'supervisor' && exists(staffPath(uid())) &&
          get(staffPath(uid())).data.get('role', 'staff') == 'supervisor');
    }

    // Admin access fields are written only by Cloud Functions.
    function roleFieldsUnchanged() {
      return unchanged('role') && unchanged('Role') && unchanged('userRole') &&
        unchanged('adminLevel') && unchanged('formerRole') &&
        unchanged('adminSince') && unchanged('promotedBy');
    }

    function noRoleKeys(data) {
      return !data.keys().hasAny(['role', 'Role', 'userRole']);
    }

    function noAdminKeys(data) {
      return !data.keys().hasAny(['adminLevel', 'formerRole', 'adminSince', 'promotedBy']);
    }

    function validNewRole(data) {
      return noAdminKeys(data) && (noRoleKeys(data) ||
        (data.keys().hasAny(['role']) &&
         !data.keys().hasAny(['Role', 'userRole']) &&
         selfAssignableRole(data.role)));
    }

    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      // Legacy role lookups query by these fields; only the caller's own
      // records match (role_based_home_page treats a denial as no match).
      allow list: if isAdmin() ||
        (signedIn() &&
          (resource.data.get('userID', null) == uid() ||
           resource.data.get('userId', null) == uid() ||
           resource.data.get('email', null) == request.auth.token.email));
      allow create: if signedIn() && uid() == userId &&
        validNewRole(request.resource.data);
      // Pick a role once (when there is none yet); never change it after.
      allow update: if signedIn() && uid() == userId &&
        (roleFieldsUnchanged() ||
         (noRoleKeys(resource.data) && noAdminKeys(resource.data) &&
          validNewRole(request.resource.data)));
      allow delete: if false;
    }

    // ---------- staff ----------

    match /staff_accounts/{staffId} {
      // A supervisor reads their facility's staff (duty log, cash
      // handovers, password resets); the app queries them by facilityId.
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.ownerId == uid() ||
           resource.data.userId == uid() ||
           resource.data.get('email', null) == request.auth.token.email)) ||
        isSupervisorOf(resource.data.get('facilityId', ''));
      // Keyed by the staff member's uid so isStaffOf() can find it. The
      // role is set once: a supervisor can't become gate staff or back.
      allow create: if isParkingOwner() &&
        request.resource.data.ownerId == uid() &&
        request.resource.data.userId == staffId &&
        request.resource.data.get('role', 'staff') in ['staff', 'supervisor'] &&
        isOwnerOf(request.resource.data.facilityId);
      allow update: if signedIn() &&
        resource.data.ownerId == uid() &&
        request.resource.data.ownerId == uid() &&
        unchanged('userId') &&
        unchanged('role') &&
        isOwnerOf(request.resource.data.facilityId);
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());
    }

    // ---------- establishments ----------

    // An optional number drivers can call (stored normalized by the app).
    function contactNumberOk() {
      let d = request.resource.data;
      return !d.keys().hasAny(['contactNumber']) ||
        (d.contactNumber is string && d.contactNumber.size() <= 20);
    }

    match /establishments/{establishmentId} {
      allow read: if isVerifiedOrStaff();
      // The rating shown to drivers is the server's (on details), never the
      // owner's: these fields stay off the owner's record.
      allow create: if isParkingOwner() &&
        request.resource.data.ownerId == uid() &&
        contactNumberOk() &&
        !request.resource.data.keys().hasAny(['rating', 'ratingCount']);
      allow update: if isAdmin() ||
        (signedIn() &&
          resource.data.ownerId == uid() &&
          request.resource.data.ownerId == uid() &&
          contactNumberOk() &&
          unchanged('rating') &&
          unchanged('ratingCount'));
      allow delete: if isAdmin();
    }

    // Owners may only (re)submit for review; approving, rejecting, suspending,
    // giving notice to fix something (complianceNotice),
    // deactivating and the review fields belong to admins. A suspended or
    // deactivated facility cannot be resubmitted - only an admin lifts it.
    function ownerReviewFieldsOk() {
      return request.resource.data.get('status', 'pending') == 'pending'
          ? !(resource.data.get('status', 'pending') in ['suspended', 'deactivated']) &&
            unchanged('rating') &&
            unchanged('ratingCount') &&
            request.resource.data.get('reviewedBy', null) == null &&
            request.resource.data.get('rejectionReason', null) == null &&
            unchanged('restrictionReason') &&
            unchanged('restrictionReasons') &&
            unchanged('complianceNotice')
          : unchanged('status') &&
            unchanged('rating') &&
            unchanged('ratingCount') &&
            unchanged('reviewedBy') &&
            unchanged('reviewedAt') &&
            unchanged('rejectionReason') &&
            unchanged('restrictionReason') &&
            unchanged('restrictionReasons') &&
            unchanged('complianceNotice');
    }

    // Minutes past the paid time a vehicle may leave without overtime.
    function gracePeriodOk() {
      let d = request.resource.data;
      return !d.keys().hasAny(['gracePeriodMinutes']) ||
        (d.gracePeriodMinutes is int &&
          d.gracePeriodMinutes >= 0 && d.gracePeriodMinutes <= 60);
    }

    // A temporary closure ("Closed until"): it ends in the future, within
    // 30 days, starts when it is set, and names who set it. Clearing it
    // (closedUntil null) is always allowed.
    function closureKeys() {
      return ['closedUntil', 'closedReason', 'closedAt', 'closedBy'];
    }

    function closureOk() {
      let d = request.resource.data;
      return !d.diff(resource.data).affectedKeys().hasAny(closureKeys()) ||
        d.get('closedUntil', null) == null ||
        (d.closedUntil is timestamp &&
          d.closedUntil > request.time &&
          d.closedUntil <= request.time + duration.value(30, 'd') &&
          d.get('closedAt', null) == request.time &&
          d.get('closedReason', '') is string &&
          d.get('closedReason', '').size() <= 120 &&
          d.get('closedBy', uid()) == uid());
    }

    match /establishment_details/{establishmentId} {
      allow read: if isVerifiedOrStaff();
      allow create: if isParkingOwner() &&
        willOwn(establishmentId) &&
        gracePeriodOk() &&
        request.resource.data.get('status', 'pending') == 'pending' &&
        request.resource.data.get('reviewedBy', null) == null &&
        !request.resource.data.keys().hasAny(['rating', 'ratingCount']);
      // The facility's supervisor may only close or reopen it.
      allow update: if isAdmin() ||
        (isOwnerOf(establishmentId) && ownerReviewFieldsOk() && gracePeriodOk() &&
          closureOk()) ||
        (isSupervisorOf(establishmentId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['closedUntil', 'closedReason', 'closedAt', 'closedBy', 'updatedAt']) &&
          closureOk());
      allow delete: if isAdmin();
    }

    // Live slot counts, kept by the updateOccupancy Cloud Function.
    match /establishment_occupancy/{establishmentId} {
      allow read: if isVerifiedOrStaff();
      allow write: if false;
    }

    // Business-document proofs: owner and admins only.
    match /establishment_private/{establishmentId} {
      allow read: if isAdmin() || isOwnerOf(establishmentId);
      allow create, update: if isOwnerOf(establishmentId);
      allow delete: if isAdmin();
    }

    // ---------- gate activity ----------

    function canSeeEstablishment(establishmentId) {
      return isAdmin() || isOwnerOf(establishmentId) || isStaffOf(establishmentId);
    }

    // Staff may only record overtime cash as collected by themselves.
    function overtimeCollectorOk() {
      return unchanged('overtimeCollectedBy') ||
        request.resource.data.overtimeCollectedBy == uid();
    }

    // Owners may switch an overtime exit between owed and collected (on the
    // ticket and its exit log), and change nothing else. Overtime can't be
    // waived; exits waived before that was removed may be set back to owed
    // or collected.
    function ownerOvertimeUpdateOk() {
      return resource.data.get('overtimeStatus', '') in
          ['cash_due', 'collected', 'waived'] &&
        request.resource.data.get('overtimeStatus', '') in
          ['cash_due', 'collected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'overtimeStatus', 'overtimeStatusBy', 'overtimeStatusAt',
          'overtimeCollectedBy', 'overtimeCollectedAt', 'updatedAt'
        ]) &&
        request.resource.data.get('overtimeStatusBy', null) == uid();
    }

    // A gate log is a record, so staff change one only in the three ways
    // the gate itself does. What a scan wrote down (plate, time, decision,
    // hours, amounts, who scanned) can't be rewritten afterwards.
    //  - an exit closes the entry log it belongs to;
    //  - an entry just admitted is refused as the wrong vehicle type;
    //  - overtime cash owed on an exit is marked collected, by themselves.
    function staffLogUpdateOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let after = request.resource.data;
      return (resource.data.get('scanType', '') == 'entry' &&
          changed.hasOnly(['isActive', 'exitAt', 'exitLogId', 'updatedAt']) &&
          after.get('isActive', false) == false) ||
        (resource.data.get('scanType', '') == 'entry' &&
          resource.data.get('isActive', false) == true &&
          changed.hasOnly(['status', 'decision', 'decisionReason', 'refusal',
            'isActive', 'refusedAt']) &&
          after.get('refusal', '') == 'wrong_vehicle' &&
          after.get('status', '') == 'DENIED' &&
          after.get('decision', '') == 'DENIED' &&
          after.get('isActive', true) == false) ||
        (resource.data.get('overtimeStatus', '') in ['cash_due', 'waived'] &&
          changed.hasOnly(['overtimeStatus', 'overtimeCollectedBy',
            'overtimeCollectedAt']) &&
          after.get('overtimeStatus', '') == 'collected' &&
          after.get('overtimeCollectedBy', '') == uid());
    }

    // A walk-in's parking fee, taken in cash by staff at its exit, is
    // written on that exit's log and can't be changed after (see
    // staffLogUpdateOk). Nowhere else carries one.
    function walkInFeeOk(d) {
      return !('walkInFee' in d) ||
        (d.get('source', '') == 'walk_in' &&
          d.get('scanType', '') == 'exit' &&
          d.walkInFee is number &&
          d.walkInFee >= 0 && d.walkInFee <= 100000);
    }

    // Cash staff took at the gate (overtime marked collected, or a walk-in
    // fee) is handed to the owner; the owner stamps each log with the
    // handover that covered it, once, so no cash is counted twice.
    function ownerHandoverUpdateOk() {
      let handover = request.resource.data.get('cashHandoverId', '');
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cashHandoverId']) &&
        !('cashHandoverId' in resource.data) &&
        (resource.data.get('overtimeStatus', '') == 'collected' ||
          resource.data.get('walkInFee', 0) > 0) &&
        handover is string && handover.size() > 0 &&
        getAfter(/databases/$(database)/documents/cash_handovers/$(handover))
          .data.establishmentId == resource.data.establishmentID;
    }

    match /activity_logs/{logId} {
      allow read: if canSeeEstablishment(resource.data.establishmentID);
      allow create: if isStaffOf(request.resource.data.establishmentID) &&
        request.resource.data.staffId == uid() &&
        !('cashHandoverId' in request.resource.data) &&
        walkInFeeOk(request.resource.data);
      allow update: if (isStaffOf(resource.data.establishmentID) &&
          staffLogUpdateOk()) ||
        (canOperate(resource.data.establishmentID) &&
          (ownerOvertimeUpdateOk() || ownerHandoverUpdateOk()));
      allow delete: if false;
    }

    // An owner's record of cash a staff member handed over: how much, from
    // how many gate logs, received when and by whom. A receipt, never
    // edited; the staff member sees their own.
    match /cash_handovers/{handoverId} {
      allow read: if isAdmin() || canOperate(resource.data.establishmentId) ||
        (signedIn() && resource.data.staffId == uid());
      // A supervisor never receives their own cash.
      allow create: if canOperate(request.resource.data.establishmentId) &&
        request.resource.data.staffId != uid() &&
        cashHandoverCreateOk(request.resource.data);
      allow update, delete: if false;
    }

    function cashHandoverCreateOk(d) {
      return d.keys().hasOnly([
          'establishmentId', 'ownerId', 'staffId', 'staffName', 'amount',
          'overtimeAmount', 'walkInAmount', 'logCount', 'receivedAt',
          'receivedBy', 'note'
        ]) &&
        d.keys().hasAll(['establishmentId', 'staffId', 'amount', 'logCount',
          'receivedAt', 'receivedBy']) &&
        d.receivedBy == uid() &&
        d.receivedAt == request.time &&
        d.staffId is string && d.staffId.size() > 0 &&
        d.amount is number && d.amount >= 0 &&
        d.logCount is int && d.logCount > 0 && d.logCount <= 400 &&
        d.get('note', '') is string && d.get('note', '').size() <= 300;
    }

    // Staff clock in and out of their shift; the owner sees who was on duty
    // when, and may close a shift someone forgot to end.
    match /staff_shifts/{shiftId} {
      allow read: if isAdmin() || canOperate(resource.data.establishmentId) ||
        (signedIn() && resource.data.staffId == uid());
      // endedAt is stored as null while on duty, so "on duty now" is a query.
      allow create: if isStaffOf(request.resource.data.establishmentId) &&
        request.resource.data.keys().hasOnly([
          'establishmentId', 'ownerId', 'staffId', 'staffName', 'startedAt',
          'endedAt'
        ]) &&
        request.resource.data.staffId == uid() &&
        request.resource.data.startedAt == request.time &&
        request.resource.data.get('endedAt', null) == null;
      allow update: if resource.data.get('endedAt', null) == null &&
        request.resource.data.endedAt == request.time &&
        ((signedIn() && resource.data.staffId == uid() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['endedAt'])) ||
          (canOperate(resource.data.establishmentId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['endedAt', 'endedBy']) &&
            request.resource.data.endedBy == uid()));
      allow delete: if false;
    }

    match /StaffActivityLogs/{logId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.staffID == uid()) ||
        canOperate(resource.data.establishmentID);
      allow create: if isStaffOf(request.resource.data.establishmentID) &&
        request.resource.data.staffID == uid();
      allow update, delete: if false;
    }

    // ---------- tickets and money (written by Cloud Functions only) ----------

    // Gate staff record check-in/out, the hours left on a reusable ticket,
    // overtime and overtime cash collected; nothing about payment.
    // A facility an admin suspended or deactivated admits no one, so its
    // tickets can't be checked in (exits still go through).
    // Nor does one closed temporarily, until its closedUntil passes.
    function facilityOpenForEntry(establishmentId) {
      let details = /databases/$(database)/documents/establishment_details/$(establishmentId);
      return !exists(details) ||
        (!(get(details).data.get('status', 'pending') in ['suspended', 'deactivated']) &&
          (get(details).data.get('closedUntil', null) == null ||
            get(details).data.closedUntil <= request.time));
    }

    function checkingIn() {
      return request.resource.data.get('entryStatus', '') == 'checked_in' &&
        resource.data.get('entryStatus', '') != 'checked_in';
    }

    function staffTicketUpdateOk() {
      return (!checkingIn() || facilityOpenForEntry(resource.data.establishmentId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'entryStatus', 'entryAt', 'entryStaffId', 'entryLogId',
        'exitAt', 'exitStaffId', 'exitLogId', 'staySeconds', 'closedSeconds',
        'remainingHours',
        'overtimeHours', 'overtimeRate', 'overtimeAmount', 'overtimeStatus',
        'overtimeCollectedBy', 'overtimeCollectedAt', 'updatedAt'
      ]) && overtimeCollectorOk();
    }

    // Staff log drive-up customers as walk-ins: already checked in, no
    // driver, no money. They only count toward slot occupancy.
    function walkInCreateOk() {
      let d = request.resource.data;
      return isStaffOf(d.establishmentId) &&
        facilityOpenForEntry(d.establishmentId) &&
        d.source == 'walk_in' &&
        d.status == 'walk_in' &&
        d.entryStatus == 'checked_in' &&
        d.entryStaffId == uid() &&
        // Car, motorcycle, or a custom type the owner added (e.g. truck).
        d.vehicleType is string &&
        d.vehicleType.size() > 0 && d.vehicleType.size() <= 20 &&
        d.keys().hasOnly([
          'establishmentId', 'ownerId', 'source', 'status', 'entryStatus',
          'entryAt', 'entryStaffId', 'entryLogId', 'vehicleType',
          'vehiclePlate', 'createdAt', 'updatedAt'
        ]);
    }

    // A ticket is for one vehicle type, not one plate: its driver may move a
    // paid ticket to another plate (stored trimmed and upper-cased, as
    // checkout does) while it isn't parked. Nothing else changes, the
    // vehicle type included.
    // Every change also records the plate it replaced in `plateHistory`
    // (append only), so a shared ticket shows which vehicles used it.
    function driverPlateUpdateOk() {
      let plate = request.resource.data.get('vehiclePlate', '');
      return signedIn() &&
        resource.data.get('driverId', '') == uid() &&
        resource.data.get('status', '') == 'paid' &&
        !(resource.data.get('entryStatus', '') in ['checked_in', 'inside']) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['vehiclePlate', 'updatedAt', 'plateHistory']) &&
        plateHistoryAppendOk() &&
        plate is string &&
        plate.size() > 0 && plate.size() <= 20 &&
        plate == plate.trim().upper() &&
        request.resource.data.get('updatedAt', null) == request.time;
    }

    // One entry added at the end, earlier ones untouched, at most 30.
    function plateHistoryAppendOk() {
      let before = resource.data.get('plateHistory', []);
      let after = request.resource.data.get('plateHistory', []);
      return before is list && after is list &&
        after.size() == before.size() + 1 &&
        after.size() <= 30 &&
        // (An empty range is an index error in rules, hence the guard.)
        (before.size() == 0 || after[0:before.size()] == before) &&
        plateHistoryEntryOk(after[before.size()]);
    }

    // { plate: the plate being replaced, until: when (the phone's clock,
    // so within 10 minutes of the server's) }.
    function plateHistoryEntryOk(e) {
      return e is map &&
        e.keys().hasOnly(['plate', 'until']) &&
        e.keys().hasAll(['plate', 'until']) &&
        e.plate == resource.data.get('vehiclePlate', '') &&
        e.until is timestamp &&
        e.until > request.time - duration.value(10, 'm') &&
        e.until < request.time + duration.value(10, 'm');
    }

    match /transactions/{transactionId} {
      allow read: if (signedIn() && resource.data.driverId == uid()) ||
        canSeeEstablishment(resource.data.establishmentId);
      allow create: if walkInCreateOk();
      allow delete: if false;
      allow update: if (isStaffOf(resource.data.establishmentId) &&
          staffTicketUpdateOk()) ||
        (canOperate(resource.data.establishmentId) && ownerOvertimeUpdateOk()) ||
        driverPlateUpdateOk();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.driverId == uid()) ||
        isOwnerOf(resource.data.establishmentId);
      allow write: if false;
    }

    // ---------- driver reports and warnings ----------

    function transactionPath(id) {
      return /databases/$(database)/documents/transactions/$(id);
    }

    // A report or flag names one or more picked reasons: `reasons`, with
    // `reason` holding them on one line (older ones have only `reason`).
    function reasonsOk(d) {
      return d.reason is string &&
        d.reason.size() > 0 &&
        (!d.keys().hasAny(['reasons']) ||
          (d.reasons is list && d.reasons.size() > 0 && d.reasons.size() <= 10));
    }

    // An owner reports the driver of one of their facility's tickets; the
    // ticket must really be that driver's, so reports can't be invented.
    // Only admins review them. Drivers never read reports.
    match /driver_reports/{reportId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.reporterId == uid());
      allow create: if ((isParkingOwner() &&
          isOwnerOf(request.resource.data.establishmentId)) ||
          isSupervisorOf(request.resource.data.establishmentId)) &&
        request.resource.data.reporterId == uid() &&
        request.resource.data.status == 'open' &&
        reasonsOk(request.resource.data) &&
        exists(transactionPath(request.resource.data.transactionId)) &&
        get(transactionPath(request.resource.data.transactionId)).data.establishmentId ==
          request.resource.data.establishmentId &&
        get(transactionPath(request.resource.data.transactionId)).data.driverId ==
          request.resource.data.driverId;
      allow update: if isAdmin() && notAboutMe(resource.data);
      allow delete: if false;
    }

    // Gate staff flag a driver's ticket for their owner, who reports it to
    // SmartPark or dismisses it. The ticket must be the staff member's
    // facility's and really be that driver's. Drivers never read flags.
    match /staff_incidents/{incidentId} {
      allow read: if isAdmin() ||
        canOperate(resource.data.establishmentId) ||
        (signedIn() && resource.data.staffId == uid());
      allow create: if isStaffOf(request.resource.data.establishmentId) &&
        request.resource.data.staffId == uid() &&
        request.resource.data.status == 'open' &&
        reasonsOk(request.resource.data) &&
        exists(transactionPath(request.resource.data.transactionId)) &&
        get(transactionPath(request.resource.data.transactionId)).data.establishmentId ==
          request.resource.data.establishmentId &&
        get(transactionPath(request.resource.data.transactionId)).data.driverId ==
          request.resource.data.driverId;
      allow update: if canOperate(resource.data.establishmentId) &&
        request.resource.data.status in ['reported', 'dismissed'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'handledAt', 'handledBy']) &&
        request.resource.data.get('handledBy', uid()) == uid();
      allow delete: if false;
    }

    // A driver reports a facility from one of their own tickets for it, so
    // reports can't be invented. Only admins review them; owners never read
    // them, so the facility is not told who reported it.
    match /facility_reports/{reportId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.driverId == uid());
      allow create: if isVerifiedOrStaff() &&
        request.resource.data.driverId == uid() &&
        request.resource.data.status == 'open' &&
        reasonsOk(request.resource.data) &&
        request.resource.data.get('details', '') is string &&
        request.resource.data.get('details', '').size() <= 1000 &&
        exists(transactionPath(request.resource.data.transactionId)) &&
        get(transactionPath(request.resource.data.transactionId)).data.driverId == uid() &&
        get(transactionPath(request.resource.data.transactionId)).data.establishmentId ==
          request.resource.data.establishmentId;
      // The admin who decides isn't the reporter either.
      allow update: if isAdmin() && notAboutMe(resource.data);
      allow delete: if false;
    }

    // A driver may contest a warning once, with a short message.
    function warningContestOk() {
      let d = request.resource.data;
      return resource.data.get('contestedAt', null) == null &&
        d.contestMessage is string &&
        d.contestMessage.size() > 0 && d.contestMessage.size() <= 500 &&
        d.contestedAt == request.time;
    }

    // Admins warn drivers; a driver reads their own warnings and may only
    // mark them as read or contest them. An admin who agrees deletes the
    // warning; one who does not records why.
    match /driver_warnings/{warningId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.driverId == uid());
      allow create: if isAdmin() && notAboutMe(request.resource.data);
      allow delete: if isAdmin() && notAboutMe(resource.data);
      allow update: if (isAdmin() && notAboutMe(resource.data)) ||
        (signedIn() && resource.data.driverId == uid() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['acknowledgedAt', 'contestMessage', 'contestedAt']) &&
          (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['contestMessage', 'contestedAt']) ||
            warningContestOk()));
    }

    match /payment_splits/{splitId} {
      allow read: if isAdmin() || isOwnerOf(resource.data.establishmentId);
      allow write: if false;
    }

    match /parking_checkouts/{checkoutId} {
      allow read: if signedIn() && resource.data.driverId == uid();
      allow write: if false;
    }

    match /stats_daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Refunds when SmartPark pulls a facility. Written only by the server;
    // drivers see theirs, owners see their facilities', admins see all.
    match /refunds/{ticketId} {
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.driverId == uid() || resource.data.ownerId == uid()));
      allow write: if false;
    }

    // What an owner still owes SmartPark for refunds they cover.
    match /owner_refund_balances/{ownerId} {
      allow read: if isAdmin() || (signedIn() && ownerId == uid());
      allow write: if false;
    }

    match /stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // A driver rates a facility after parking there: one rating per ticket
    // (its id), only on their own ticket once it has been used (an exit is
    // on record), 1-5 stars and an optional comment. They may change it;
    // the facility's owner reads it; the server keeps the average.
    function ratingFieldsOk(ticketId) {
      let d = request.resource.data;
      let t = get(/databases/$(database)/documents/transactions/$(ticketId)).data;
      return signedIn() &&
        d.driverId == uid() &&
        t.get('driverId', '') == uid() &&
        d.establishmentId == t.get('establishmentId', '') &&
        t.get('exitAt', null) != null &&
        d.keys().hasOnly(['establishmentId', 'driverId', 'stars', 'comment',
          'createdAt', 'updatedAt']) &&
        d.stars is int && d.stars >= 1 && d.stars <= 5 &&
        d.get('comment', '') is string && d.get('comment', '').size() <= 300 &&
        d.updatedAt == request.time;
    }

    match /facility_ratings/{ticketId} {
      // A missing rating reads as missing (nothing to hide), so the ticket
      // screen can tell whether to ask for one.
      allow get: if signedIn() && (resource == null ||
        resource.data.driverId == uid() ||
        canOperate(resource.data.establishmentId) || isAdmin());
      allow list: if isAdmin() || canOperate(resource.data.establishmentId) ||
        (signedIn() && resource.data.driverId == uid());
      allow create: if ratingFieldsOk(ticketId) &&
        request.resource.data.createdAt == request.time;
      allow update: if ratingFieldsOk(ticketId) &&
        resource.data.driverId == uid() &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Who did what to facilities, staff, refunds, warnings and reports.
    // Written only by Cloud Functions (src/audit.js) and never changed.
    // Admins read every entry; an owner reads the ones about their own
    // facility and staff (entries carrying their ownerId).
    match /audit_logs/{entryId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.ownerId == uid());
      allow write: if false;
    }

    // Daily payment-health counters (src/payment_health.js). Server only;
    // admins read a summary through the getPaymentHealth function.
    match /payment_health_daily/{day} {
      allow read, write: if false;
    }

    // When each account last downloaded its data (a rate limit kept by
    // the exportMyData function). Server only.
    match /data_exports/{userId} {
      allow read, write: if false;
    }

    // ---------- platform settings and announcements ----------

    // The commission rate and any scheduled change (src/commission.js).
    // Everyone signed in sees it; only the server writes it.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Which announcements a role reads: its own audience, and 'all'.
    function myAudience() {
      let role = myRole();
      return role == 'Parking Owner' ? 'owners'
        : role == 'Driver' ? 'drivers'
        : role in ['staff', 'supervisor'] ? 'staff'
        : '';
    }

    // Platform notices, e.g. a commission change. Written by the server.
    match /announcements/{announcementId} {
      allow read: if isAdmin() ||
        (signedIn() &&
          (resource.data.audience == 'all' ||
            resource.data.audience == myAudience()));
      allow write: if false;
    }

    // When a user saw an announcement, and (for a commission change) when
    // they acknowledged it. Only that user writes their own, and only these
    // fields. Admins count acknowledgements.
    match /users/{userId}/announcement_reads/{announcementId} {
      allow read: if isAdmin() || (signedIn() && uid() == userId);
      allow create, update: if signedIn() && uid() == userId &&
        request.resource.data.keys().hasOnly([
          'announcementId', 'seenAt', 'acknowledgedAt', 'acknowledged'
        ]) &&
        request.resource.data.announcementId == announcementId &&
        request.resource.data.get('seenAt', request.time) is timestamp &&
        request.resource.data.get('acknowledgedAt', request.time) is timestamp &&
        request.resource.data.get('acknowledged', true) == true;
      allow delete: if false;
    }

    // The admin's acknowledgement count, across every user.
    match /{path=**}/announcement_reads/{announcementId} {
      allow read: if isAdmin();
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
